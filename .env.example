# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file (it contains your bot's secret token).

# From the Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# Right-click the demo channel in Discord (with Developer Mode on) -> Copy Channel ID
DEMO_CHANNEL_ID=123456789012345678

# Optional: how many recent messages to scan per /randomdemo run (default 2000)
HISTORY_LIMIT=2000
